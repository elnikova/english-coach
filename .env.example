# ── Gemini (безкоштовно, ключ на https://aistudio.google.com/apikey) ──────────
COACH_PROVIDER=gemini
GEMINI_API_KEY=AIza...
# Модель можна змінити. Список доступних: python models.py
COACH_MODEL=gemini-2.5-flash

# ── Доступ з інших пристроїв ──────────────────────────────────────────────────
# Залиште рядок закоментованим — застосунок буде видно лише на цьому комп'ютері.
# Розкоментуйте — буде видно ще й вашим пристроям у Tailscale.
# COACH_HOST=0.0.0.0

# ── Anthropic (платно) ────────────────────────────────────────────────────────
# Щоб перейти назад, замініть рядки вище на ці три:
# COACH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-haiku-5-5
