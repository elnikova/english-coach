# ── Gemini (безкоштовно, ключ на https://aistudio.google.com/apikey) ──────────
COACH_PROVIDER=gemini
GEMINI_API_KEY=AIza...
# Модель можна змінити. Список доступних: python models.py
COACH_MODEL=gemini-2.5-flash

# ── Anthropic (платно) ────────────────────────────────────────────────────────
# Щоб перейти назад, замініть рядки вище на ці три:
# COACH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
